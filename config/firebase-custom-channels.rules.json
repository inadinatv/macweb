{
  "macweb": {
    "customChannels": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'macweb-admin' && auth.token.admin == true",
      ".validate": "newData.numChildren() <= 5",
      "$slot": {
        ".validate": "$slot.matches(/^channel[1-5]$/) && newData.hasChildren(['name', 'iframeUrl']) && newData.numChildren() == 2",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 48"
        },
        "iframeUrl": {
          ".validate": "newData.isString() && newData.val().length >= 9 && newData.val().length <= 2048 && newData.val().beginsWith('https://')"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
